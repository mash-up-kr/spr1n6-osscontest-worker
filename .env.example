# 통합 테스트 실행 시 DB_URL은 이름에 test 또는 integration이 포함된 전용 DB를 지정합니다.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

INDEXING_DB_QUEUE_ENABLED=true
INDEXING_QUEUE_CONCURRENCY=5
INDEXING_QUEUE_POLL_INTERVAL=PT30S
INDEXING_QUEUE_CLAIM_ERROR_DELAY=PT1S
INDEXING_QUEUE_NOTIFICATIONS_ENABLED=true
INDEXING_QUEUE_NOTIFICATION_CHANNEL=indexing_job
INDEXING_LEASE_DURATION=PT60S
INDEXING_HEARTBEAT_INTERVAL=PT10S
INDEXING_DB_CHECK_INTERVAL=PT5S
INDEXING_CIRCUIT_BREAKER_OPEN_DURATION=PT60S
INDEXING_CIRCUIT_BREAKER_CALL_DURATION=PT90S

INDEXING_MAX_TOKENS_PER_CHUNK=512
INDEXING_OVERLAP_TOKENS=64

INDEXING_STORAGE_BUCKET=
INDEXING_STORAGE_ENDPOINT=
INDEXING_STORAGE_REGION=us-east-1
INDEXING_STORAGE_DOWNLOAD_TIMEOUT=PT30S

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

OPENAI_API_KEY=

FAULT_INJECTION_ENABLED=false
FAULT_INJECTION_PHASE=EMBEDDING

# Enable only after Core confirms INDEX Jobs are registered after successful object upload.
INDEXING_JOB_AFTER_UPLOAD_CONFIRMED=false
